# TrueFoundry Agent Harness credentials.
# Copy to .env.local and fill in. Never commit the filled-in file.
#
# Without these, CapyGuard runs in replay mode against recorded inspection
# traces, which is also what the offline demo path uses.

TFY_GATEWAY_URL=https://your-gateway-host/your-tenant
TFY_API_KEY=

# Name of the agent created from agent/manifest.ts
CAPYGUARD_AGENT_NAME=capyguard-inspector
