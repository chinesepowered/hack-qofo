# TrueForge harness connection.
# Copy to .env.local and fill in. Never commit the filled-in file.
#
# Without these, CapyGuard runs in replay mode against recorded inspection
# traces, and pasted artifacts get the offline pattern pass. That is what the
# demo runs on, so the app is fully usable with this file absent.
#
# Run `pnpm check-harness` after filling this in. It reports which prerequisite
# is missing, and `--create` will register the agent for you.

# Where the harness is listening. TrueForge standalone defaults to this.
#   npx @truefoundry/trueforge@latest
#
# Windows note: the harness does not boot on win32 (an ESM path bug in 0.1.4
# and the release candidate, plus its local sandbox provider is macOS/Linux
# only). Run it inside WSL2 from your Linux home directory — not /mnt/c, which
# is slow — and WSL2 localhost forwarding makes it reachable from Windows with
# no change to this value.
TRUEFORGE_BASE_URL=http://localhost:8790

# Only needed when the harness has OIDC login enabled. Standalone mode has no
# login and no API-key scheme, so leave this empty for local use.
TRUEFORGE_TOKEN=

# Must match a model name from Settings → Models in the harness UI. For an
# OpenAI-compatible endpoint, add it as a `custom` provider with its base URL,
# API key, and model ids; the name below is then whatever you listed there.
CAPYGUARD_MODEL=Qwen/Qwen3.8-Max

# The saved agent to run. `pnpm check-harness --create` registers it from
# agent/manifest.ts.
CAPYGUARD_AGENT_NAME=capyguard-inspector
