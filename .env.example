# TrueFoundry Agent Harness credentials.
# Copy to .env.local and fill in. Never commit the filled-in file.
#
# Without these, CapyGuard runs in replay mode against recorded inspection
# traces, and pasted artifacts get the offline pattern pass. That is also what
# the offline demo path uses, so the app is fully usable with this file absent.
#
# Run `pnpm check-gateway` after filling this in. It reports which of the four
# prerequisites (credentials, auth, model access, agent) is missing.

# Gateway host plus YOUR TENANT as the first path segment.
#   SaaS host:  https://gateway.truefoundry.ai
#   Full value: https://gateway.truefoundry.ai/<tenant>
#
# To find your tenant, request an agent path with a deliberately wrong first
# segment; the gateway names your tenant in the error:
#   curl -H "Authorization: Bearer $TFY_API_KEY" \
#        https://gateway.truefoundry.ai/api/agent/agents/sessions
#   -> "Tenant mismatch: tenant '<your-tenant>' does not match requested tenant 'api'"
#
# Sessions then live at <TFY_GATEWAY_URL>/v1/agents/sessions.
TFY_GATEWAY_URL=https://gateway.truefoundry.ai/your-tenant

TFY_API_KEY=

# Must match an agent that exists in your workspace. Create it from
# agent/manifest.ts — `pnpm check-gateway --print-manifest` prints the JSON.
CAPYGUARD_AGENT_NAME=capyguard-inspector

# TrueFoundry model ids are generally <provider-account>/<model>, and the
# account name is chosen by whoever configured the gateway, so the exact string
# varies between workspaces. check-gateway lists what your key can actually see.
CAPYGUARD_MODEL=gemini-3.7-flash
